# Optional. The app is "bring your own key": each visitor pastes their own free
# Groq key in the UI (stored in their browser), so you usually need NOTHING here.
#
# Set GROQ_API_KEY only if you want a server-side fallback key for visitors who
# don't enter their own (note: then YOUR key pays for their usage).
# Get a free key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Optional: change the model or switch providers (OpenAI-compatible).
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.groq.com/openai/v1
#
# Example — switch to Google Gemini instead (free, but unreliable from cloud hosts):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.0-flash

# ── AI Image Generator (Design section) ──────────────────────────────────────
# The Image Generator tool supports two providers:
#
# 1. OpenAI (gpt-image-2.6 / 2.5) — users supply their own OpenAI key via the
#    "API key" button in the UI. No server-side key needed. If you want a
#    server-side fallback key set it here (users without a key will use it):
# OPENAI_API_KEY=sk-...
#
# 2. Qwen Image 2.1 — free via the public Hugging Face Space. No key required.
#    Optional: add an HF_TOKEN if your account needs one for the Qwen Space:
# HF_TOKEN=hf_...
